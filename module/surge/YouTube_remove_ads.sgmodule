#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-10-02 13:57:49
#!arguments=blockUpload:false,blockShorts:false,blockImmersive:false,captionLang:zh-Hans,debug:false
#!arguments-desc=blockUpload: 隐藏上传按钮; 用于隐藏YouTube底栏的上传按钮 (true/false)\nblockShorts: 隐藏Shorts按钮; 用于隐藏YouTube底栏的Shorts按钮 (true/false)\nblockImmersive: 隐藏选段按钮; 用于隐藏YouTube Music底栏的选段按钮 (true/false)\ncaptionLang: 字幕翻译语言; 需要把YouTube字幕翻译翻译为何种语言 (zh-Hans/zh-Hant/ja/ko/en/off)\ndebug: 启用调试模式; 此插件的调试模式 (true/false)

[Script]
YouTube_remove_ads_1 = type=http-response,pattern=(?i)^https://youtubei\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\?(.*))?$,script-path=https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-56c1eff77ee2.js,timeout=20,requires-body=true,binary-body-mode=true,argument="{\"enabled\":true,\"value\":{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}}"
YouTube_remove_ads_2 = type=http-request,pattern=(?i)^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack.*,script-path=https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-3284220b843a.js,timeout=20,requires-body=true,binary-body-mode=true,argument="{\"enabled\":true,\"value\":{\"captionLang\":\"{{{captionLang}}}\"}}"
YouTube_remove_ads_3 = type=http-request,pattern=(?i)^https://youtubei\.googleapis\.com/youtubei/v1/log_event,script-path=https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-1f69f0924714.js,timeout=20,requires-body=true,binary-body-mode=true,argument="{\"enabled\":true,\"value\":{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
