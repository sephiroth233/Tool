#!name=网易云音乐去广告
#!desc=过滤网易云音乐广告，并允许自定义界面。
#!openUrl=https://apps.apple.com/app/id590338362
#!author=RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseCloudMusic.png
#!date=2026-10-02 13:57:49
#!arguments=MY:false,DT:false,FX:false,PRGG:false,PRRK:false,PRDRD:false,PRSCVPT:false,PRST:false,PRRR:false,HMPR:false,PRMST:false,PRCN:false
#!arguments-desc=MY: [隐藏底栏]漫游标签 (true/false)\nDT: [隐藏底部]笔记标签 (true/false)\nFX: [隐藏底部]发现标签 (true/false)\nPRGG: [隐藏首页]问候语 (true/false)\nPRRK: [隐藏首页]排行榜 (true/false)\nPRDRD: [隐藏首页]每日推荐 (true/false)\nPRSCVPT: [隐藏首页]推荐歌单 (true/false)\nPRST: [隐藏首页]最近常听 (true/false)\nPRRR: [隐藏首页]雷达歌单 (true/false)\nHMPR: [隐藏首页]音乐合伙人 (true/false)\nPRMST: [隐藏首页]推荐专属歌单 (true/false)\nPRCN: [隐藏首页]你的专属歌单 (true/false)

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmatapk.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmat.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmatvideo.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,ipv4.music.163.com,REJECT,extended-matching,pre-matching
DOMAIN,ipv6.music.163.com,REJECT,extended-matching,pre-matching

[Map Local]
(?i)^https?://interface\d?\.music\.163\.com/e?api/(ocpc/)?ad/ data-type=text data="" status-code=200 header="Content-Type:text/plain"
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:delivery/(batch-)?deliver|moment/tab/info/|side-bar/mini-program/music-service/account|yunbei/account/entrance/) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:community/friends/fans-group/artist/group/|mine/applet/redpoint|music/songshare/text/recommend/|resniche/position/play/new/|resniche/tspopup/show|resource/comments?/musiciansaid/|user/sub/artist) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:ios/version|mlivestream/entrance/playpage/|link/position/show/strategy|link/scene/show/resource|v1/content/exposure/comment/banner/) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163.com/w?e?api/search/default data-type=text data="" status-code=200 header="Content-Type:text/plain"
(?i)^https?://interface\d?\.music\.163\.com/w?eapi/(?:activity/bonus/playpage/time/query|resource-exposure/|search/(?:chart/|rcmd/keyword/|specialkeyword/)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://interface\d\.music\.163\.com/eapi/my/podcast/tab/recommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
NeteaseCloudMusic_remove_ads_1 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:batch|v2/resource/comment/floor/get),script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js,timeout=20,requires-body=true,binary-body-mode=true
NeteaseCloudMusic_remove_ads_2 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:homepage/block/page|link/page/rcmd/(?:block/resource/multi/refresh|resource/show)),script-path=https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/NeteaseCloudMusic_remove_ads-35cb151df260.js,timeout=20,requires-body=true,binary-body-mode=true,argument="{\"enabled\":true,\"value\":{\"PRGG\":{{{PRGG}}},\"PRRK\":{{{PRRK}}},\"PRDRD\":{{{PRDRD}}},\"PRSCVPT\":{{{PRSCVPT}}},\"PRST\":{{{PRST}}},\"PRRR\":{{{PRRR}}},\"HMPR\":{{{HMPR}}},\"PRMST\":{{{PRMST}}},\"PRCN\":{{{PRCN}}}}}"
NeteaseCloudMusic_remove_ads_3 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/link/home/framework/tab,script-path=https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/NeteaseCloudMusic_remove_ads-a65f8f0d2fe1.js,timeout=20,requires-body=true,binary-body-mode=true,argument="{\"enabled\":true,\"value\":{\"MY\":{{{MY}}},\"DT\":{{{DT}}},\"FX\":{{{FX}}}}}"
NeteaseCloudMusic_remove_ads_4 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/link/page/discovery/resource/show,script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js,timeout=20,requires-body=true,binary-body-mode=true
NeteaseCloudMusic_remove_ads_5 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/link/position/show/resource,script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js,timeout=20,requires-body=true,binary-body-mode=true
NeteaseCloudMusic_remove_ads_6 = type=http-response,pattern=(?i)^https?://interface\d?\.music\.163\.com/eapi/user/follow/users/mixed/get,script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js,timeout=20,requires-body=true,binary-body-mode=true

[MITM]
hostname = %APPEND% interface*.music.163.com
