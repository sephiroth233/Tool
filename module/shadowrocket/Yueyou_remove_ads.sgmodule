#!name=阅友去广告
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!openUrl=https://apps.apple.com/app/id1066723192
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Yueyou.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN,ads.reader.yueyouxs.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? 'delpaths([["data", "isShowDLPopup"],["data", "isShowGame"],["data", "touTiaoShowDlPopup"],["data", "offLineDownload", "WatchVideoBtnDesc"],["data", "readVipFirstCfg"],["data", "readVipNormalCfg"],["data", "notifyAd"],["data", "hotStartSplashTime"],["data", "hotStartReqSwitch"],["data", "isShowBFTab"],["data", "popReqDelayTime"],["data", "benefitCfg"],["data", "chestTask"],["data", "hotStartAd"],["data", "activeTagList"],["data", "secondOrderCfg"],["data", "secondOrderList"],["data", "blockedWordsCfg"],["data", "aaReportListCfg"],["data", "pddAdSwitch"],["data", "isShowShelfAuthPopup"],["data", "firstPopUpAmount"]])'
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? 'if ((getpath(["data"]) // {}) | has("isAdClosed")) then setpath(["data", "isAdClosed"];true) else . end'

[MITM]
hostname = %APPEND% goway.reader.yueyouxs.com
