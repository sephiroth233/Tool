#!name=小红书去广告
#!desc=过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。
#!openUrl=https://apps.apple.com/app/id741292507
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!date=2026-10-02 13:57:49

[Rule]
AND,((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)),REJECT

[Map Local]
(?i)^https://ci\.xiaohongshu\.com/system_config/watermark data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"
(?i)^https://edith\.xiaohongshu\.com/api/sns/v1/surprisebox/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.xiaohongshu\.com/api/marketing/box/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://edith\.xiaohongshu\.com/api/sns/(?:v2/guide/user_banner|v3/note/guide) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.xiaohongshu\.com/api/sns/(?:v1/ads/resource|v2/hey/\w+/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v1/search/banner_list$ 'if ((getpath([]) // {}) | has("data")) then setpath(["data"];"{}") else . end'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v1/search/hot_list$ 'if ((getpath(["data"]) // {}) | has("items")) then setpath(["data", "items"];"[]") else . end'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v4/search/hint 'if ((getpath(["data"]) // {}) | has("hint_words")) then setpath(["data", "hint_words"];"[]") else . end'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v4/search/trending\? 'if ((getpath(["data"]) // {}) | has("queries")) then setpath(["data", "queries"];"[]") else . end | if ((getpath(["data"]) // {}) | has("hint_word")) then setpath(["data", "hint_word"];"{}") else . end'

[Script]
RedPaper_remove_ads_1 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v1/note/(?:imagefeed|live_photo/save),script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_2 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v1/system/service/ui/config\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_3 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v1/system_service/config\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_4 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v2/system_service/splash_config,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_5 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v2/(?:note/widgets|user/followings/followfeed),script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_6 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v4/followfeed\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_7 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/v5/recommend/user/follow_recommend\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_8 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/(?:v1/interaction/comment/video/download|v5/note/comment/list),script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_9 = type=http-response,pattern=(?i)^https://edith\.xiaohongshu\.com/api/sns/(?:v2/note/feed|v3/note/videofeed),script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_10 = type=http-response,pattern=(?i)^https://(?:edith|rec)\.xiaohongshu\.com/api/sns/v6/homefeed\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_11 = type=http-response,pattern=(?i)^https://(?:edith|so)\.xiaohongshu\.com/api/sns/v10/search/notes\?,script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true
RedPaper_remove_ads_12 = type=http-response,pattern=(?i)^https://(?:edith|rec|www)\.xiaohongshu\.com/api/sns/(?:v4/note/videofeed|v10/note/video/save),script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,timeout=20,requires-body=true

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
