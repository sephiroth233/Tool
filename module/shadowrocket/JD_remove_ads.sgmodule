#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。
#!openUrl=https://apps.apple.com/app/id414245413
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!date=2026-10-02 13:57:49

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT

[Map Local]
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig 'if ((getpath(["data", "JDMessage", "socketmonitor"]) // {}) | has("isSocketEstablishedAhead")) then setpath(["data", "JDMessage", "socketmonitor", "isSocketEstablishedAhead"];0) else . end | if ((getpath(["data", "JDMessage", "socketmonitor"]) // {}) | has("isSocketReport")) then setpath(["data", "JDMessage", "socketmonitor", "isSocketReport"];0) else . end | if ((getpath(["data", "JDHttpToolKit", "httpdns"]) // {}) | has("httpdns")) then setpath(["data", "JDHttpToolKit", "httpdns", "httpdns"];0) else . end'

[Script]
JD_remove_ads_1 = type=http-response,pattern=(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome),script-path=https://kelee.one/Resource/JavaScript/JD/JD_remove_ads.js,timeout=20,requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com
