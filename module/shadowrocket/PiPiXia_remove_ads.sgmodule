#!name=皮皮虾去广告
#!desc=移除开屏广告、评论区广告、视频流广告，精简我的页面。
#!openUrl=https://apps.apple.com/app/id1393912676
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PiPiXia.png
#!date=2026-10-02 13:57:49

[Map Local]
(?i)^https://api(5-lq)?\.pipix\.com/api/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api(5-lq)?\.pipix\.com/bds/banner/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api(5-lq)?\.pipix\.com/bds/feed/follow_feed/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api(5-lq)?\.pipix\.com/bds/feed/stream/v2/ '.data.data |= map(select(has("ad_info") | not))'
http-response-jq (?i)^https://api(5-lq)?\.pipix\.com/bds/user/check_in/ '.data.profile_entrances |= map(select(.title != "放心借" and .title != "洋钱罐借款")) | del(.data.pet_interface_message)'

[MITM]
hostname = %APPEND% api.pipix.com, api5-lq.pipix.com
