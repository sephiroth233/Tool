      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.goofish\\.com/gw/mtop\\.taobao\\.idle\\.item\\.recommend\\.list/"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.goofish\\.com/gw/mtop\\.taobao\\.idle\\.local\\.near\\.by\\.corner\\.info/"
      text: "{}"
