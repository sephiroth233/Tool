# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "微信公众号去广告"
desc: "过滤微信公众号广告"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png"
rules:
  - "DOMAIN-SUFFIX,wxs.qq.com,REJECT"
http:
  mock:
    -
      match: "(?i)^https://mp\\.weixin\\.qq\\.com/mp/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://mp\\.weixin\\.qq\\.com/mp/relatedsearchword"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  mitm:
    - "mp.weixin.qq.com"
