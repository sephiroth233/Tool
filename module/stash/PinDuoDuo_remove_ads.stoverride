    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/order_detail_group\\? response-jq delpaths([[\"data\", \"goods_list\"]])"
    - "(?i)^https://api\\.pinduoduo\\.com/order/ response-jq delpaths([[\"marketing_banner_vo\"],[\"shipping\", \"banner_above_recommend\"]])"
    - "(?i)^https://api\\.pinduoduo\\.com/api/aristotle/order_list_v4\\? response-jq .orders |= map(.order_buttons |= map(del(.order_growth_tip)))"
