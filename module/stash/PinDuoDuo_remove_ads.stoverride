    - "(?i)^https://api\\.pinduoduo\\.com/api/philo/personal/hub\\? response-jq delpaths([[\"monthly_card_entrance\"],[\"personal_center_style_v2_vo\"],[\"icon_set\", \"icons\"],[\"icon_set\", \"top_personal_icons\"],[\"personal_banner\"]])"
