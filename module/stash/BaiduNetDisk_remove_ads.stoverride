# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "百度网盘去广告"
desc: "移除开屏广告、首页卡片广告、传输页面广告、各类弹窗，精简侧拉抽屉和我的页面。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduNetDisk.png"
http:
  mock:
    -
      match: "(?i)^https://pan\\.baidu\\.com/api/getconfig\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/api/getsyscfg\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/api/taskscore/tasklist\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/act/api/activityentry\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/rest/\\d\\.\\d/pcs/adv\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/api/plugin/get\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://pan\\.baidu\\.com/recommend/query/list\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  body-rewrite:
    - "(?i)^https://pan\\.baidu\\.com/feed/kingkongdistrict\\? response-jq .data.data |= map(select(.type != \"novel\" and .type != \"shortplay\" and .type != \"print\" and .type != \"job_hunt\"))"
  mitm:
    - "pan.baidu.com"
