# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "叮咚买菜去广告"
desc: "移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png"
rules:
  - "DOMAIN,trackercollect.ddxq.mobi,REJECT"
  - "DOMAIN,ddfs-public.ddimg.mobi,REJECT"
  - "DOMAIN,rttrack.ddxq.mobi,REJECT"
http:
  mock:
    -
      match: "(?i)^https?://119\\.29\\.29\\.\\d+/d"
      text: ""
      status-code: 200
      headers:
        Content-Type: "text/plain"
    -
      match: "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/advert/"
      text: ""
      status-code: 404
      headers:
        Content-Type: "text/plain"
    -
      match: "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/homeApi/getHomeAdPop"
      text: ""
      status-code: 404
      headers:
        Content-Type: "text/plain"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/vip/getVipAd/\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/homeApi/marketingNotice\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/search/rollHotKeyword\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/search/rankingList\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/search/hotKeyword\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/order/getRecommend$"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/homeApi/userLike\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://user\\.api\\.ddxq\\.mobi/userportal-service/api/v1/user/queryMyPage/\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://maicai\\.api\\.ddxq\\.mobi/guide-service/userLike/flowData$"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  body-rewrite:
    - "(?i)^https://maicai\\.api\\.ddxq\\.mobi/homeApi/categoriesNewDetail\\? response-jq delpaths([[\"data\", \"ad_info\"]])"
    - "(?i)^https://maicai\\.api\\.ddxq\\.mobi/tool/getConfig\\? response-jq delpaths([[\"data\", \"ai_enter_config\"]])"
    - "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/homeApi/newDetails\\? response-jq delpaths([[\"data\", \"top_advert_data\"],[\"data\", \"suspension\"]])"
    - "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/homeApi/newDetails\\? response-jq .data.list |= map(select(has(\"capsule_freedom_zone\") | not))"
    - "(?i)^https://maicai\\.api\\.ddxq\\.mobi/guide-service/productApi/productDetail/info\\? response-jq delpaths([[\"data\", \"detail\", \"chatEntry\"]])"
    - "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/homeApi/bottomNavi response-jq del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != \"eatwhat\")) else . end"
    - "(?i)^https?://maicai\\.api\\.ddxq\\.mobi/homeApi/homeFlowDetail response-jq walk(if type == \"object\" and has(\"list\") then .list |= map(if type == \"object\" and has(\"multi_advertise_data_list\") then del(.multi_advertise_data_list) else . end) else . end)"
  mitm:
    - "119.29.29.*"
    - "maicai.api.ddxq.mobi"
    - "user.api.ddxq.mobi"
