# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "淘宝去广告"
desc: "过滤淘宝开屏广告"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Taobao.png"
rules:
  - "DOMAIN,adashx.m.taobao.com,REJECT"
  - "DOMAIN,ossgw.alicdn.com,REJECT"
  - "DOMAIN,ems.youku.com,REJECT"
  - "DOMAIN,hudong.alicdn.com,REJECT"
  - "DOMAIN,h-adashx.ut.taobao.com,REJECT"
  - "DOMAIN,ut.taobao.com,REJECT"
http:
  mock:
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.fliggy\\.crm\\.screen\\.(allresource|predict)"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.alibaba\\.advertisementservice\\.getadv"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.alimama\\.etao\\.config\\.query/.+?etao_advertise"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.alimusic\\.common\\.mobileservice\\.startinit"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.etao\\.noah\\.query/.+tao_splash"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.film\\.mtopadvertiseapi\\.queryadvertise"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.o2o\\.ad\\.gateway\\.get"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.taobao\\.idle\\.home\\.welcome"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://acs\\.m\\.taobao\\.com/gw/mtop\\.trip\\.activity\\.querytmsresources"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://(?:gw|heic)\\.alicdn\\.com/imgextra/i\\d/\\d*/?[\\w!]+-\\d-(?:octopus|tps)-(?:1080|1125)-\\d{4}\\.(?:jpg|png)_(?:1\\d{3}|9\\d{2})x(?:\\d|1\\d{3}|9\\d{2})q[59]0"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://guide-acs\\.m\\.taobao\\.com/gw/mtop\\.taobao\\.(volvo\\.secondfloor\\.getconfig|wireless\\.home\\.newface\\.awesome\\.get)"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  script:
    -
      match: "(?i)^https://guide-acs\\.m\\.taobao\\.com/gw/mtop\\.taobao\\.(cloudvideo\\.video\\.query|wireless\\.home\\.splash\\.awesome\\.get)"
      name: "pm_9d853d73b21f"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://poplayer\\.template\\.alibaba\\.com/\\w+\\.json"
      name: "pm_9d853d73b21f"
      type: "response"
      timeout: 20
      require-body: true
  mitm:
    - "acs.m.taobao.com"
    - "heic.alicdn.com"
    - "guide-acs.m.taobao.com"
    - "poplayer.template.alibaba.com"
script-providers:
  pm_9d853d73b21f:
    url: "https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js"
    interval: 86400
