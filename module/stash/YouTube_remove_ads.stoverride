# Generated locally from Loon. Parameters are fixed at build time for Stash.
# blockUpload = false ; 隐藏上传按钮
# blockShorts = false ; 隐藏Shorts按钮
# blockImmersive = false ; 隐藏选段按钮
# captionLang = "zh-Hans" ; 字幕翻译语言
# debug = false ; 启用调试模式
name: "YouTube去广告"
desc: "移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png"
http:
  script:
    -
      match: "(?i)^https://youtubei\\.googleapis\\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\\?(.*))?$"
      name: "pm_ec126cbc37a1"
      type: "response"
      timeout: 20
      require-body: true
      binary-mode: true
      argument: "{\"enabled\":true,\"value\":{\"blockUpload\":false,\"blockShorts\":false,\"blockImmersive\":false,\"captionLang\":\"zh-Hans\",\"debug\":false}}"
    -
      match: "(?i)^https?://[\\w-]+\\.googlevideo\\.com/initplayback.+&ack.*"
      name: "pm_6d271f2e4abe"
      type: "request"
      timeout: 20
      require-body: true
      binary-mode: true
      argument: "{\"enabled\":true,\"value\":{\"captionLang\":\"zh-Hans\"}}"
    -
      match: "(?i)^https://youtubei\\.googleapis\\.com/youtubei/v1/log_event"
      name: "pm_9c801e9c7459"
      type: "request"
      timeout: 20
      require-body: true
      binary-mode: true
      argument: "{\"enabled\":true,\"value\":{\"blockUpload\":false,\"blockShorts\":false,\"blockImmersive\":false,\"captionLang\":\"zh-Hans\",\"debug\":false}}"
  mitm:
    - "*.googlevideo.com"
    - "youtubei.googleapis.com"
script-providers:
  pm_ec126cbc37a1:
    url: "https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-56c1eff77ee2.js"
    interval: 86400
  pm_6d271f2e4abe:
    url: "https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-3284220b843a.js"
    interval: 86400
  pm_9c801e9c7459:
    url: "https://raw.githubusercontent.com/mlang233/Tool/master/module/scripts/YouTube_remove_ads-1f69f0924714.js"
    interval: 86400
