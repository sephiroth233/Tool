# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "小红书去广告"
desc: "过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png"
rules:
  - "AND,((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)),REJECT"
http:
  mock:
    -
      match: "(?i)^https://ci\\.xiaohongshu\\.com/system_config/watermark"
      base64: "R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
      status-code: 200
      headers:
        Content-Type: "image/gif"
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/surprisebox/(?:get_style|open|submit_action)"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://www\\.xiaohongshu\\.com/api/marketing/box/trigger\\?"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/(?:v2/guide/user_banner|v3/note/guide)"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://www\\.xiaohongshu\\.com/api/sns/(?:v1/ads/resource|v2/hey/\\w+/hey_gallery)"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  body-rewrite:
    - "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/search/banner_list$ response-jq if ((getpath([]) // {}) | has(\"data\")) then setpath([\"data\"];\"{}\") else . end"
    - "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/search/hot_list$ response-jq if ((getpath([\"data\"]) // {}) | has(\"items\")) then setpath([\"data\", \"items\"];\"[]\") else . end"
    - "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v4/search/hint response-jq if ((getpath([\"data\"]) // {}) | has(\"hint_words\")) then setpath([\"data\", \"hint_words\"];\"[]\") else . end"
    - "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v4/search/trending\\? response-jq if ((getpath([\"data\"]) // {}) | has(\"queries\")) then setpath([\"data\", \"queries\"];\"[]\") else . end | if ((getpath([\"data\"]) // {}) | has(\"hint_word\")) then setpath([\"data\", \"hint_word\"];\"{}\") else . end"
  script:
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/note/(?:imagefeed|live_photo/save)"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/system/service/ui/config\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v1/system_service/config\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v2/system_service/splash_config"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v2/(?:note/widgets|user/followings/followfeed)"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v4/followfeed\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/v5/recommend/user/follow_recommend\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/(?:v1/interaction/comment/video/download|v5/note/comment/list)"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://edith\\.xiaohongshu\\.com/api/sns/(?:v2/note/feed|v3/note/videofeed)"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://(?:edith|rec)\\.xiaohongshu\\.com/api/sns/v6/homefeed\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://(?:edith|so)\\.xiaohongshu\\.com/api/sns/v10/search/notes\\?"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
    -
      match: "(?i)^https://(?:edith|rec|www)\\.xiaohongshu\\.com/api/sns/(?:v4/note/videofeed|v10/note/video/save)"
      name: "pm_a29fbc10f00c"
      type: "response"
      timeout: 20
      require-body: true
  mitm:
    - "ci.xiaohongshu.com"
    - "edith.xiaohongshu.com"
    - "rec.xiaohongshu.com"
    - "so.xiaohongshu.com"
    - "www.xiaohongshu.com"
script-providers:
  pm_a29fbc10f00c:
    url: "https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js"
    interval: 86400
