# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "下厨房去广告"
desc: "移除开屏广告、页面推广及横幅，精简首页标签。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaChuFang.png"
http:
  mock:
    -
      match: "(?i)^https://api\\.xiachufang\\.com/v2/ad/"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://api\\.xiachufang\\.com/v2/account/feeds_v7\\.json"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://api\\.xiachufang\\.com/v2/homepage1810/init_page\\.json"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
    -
      match: "(?i)^https://api\\.xiachufang\\.com/v2/mark_mission/get_sticker_info\\.json"
      text: "{}"
      status-code: 200
      headers:
        Content-Type: "application/json"
  body-rewrite:
    - "(?i)^https://api\\.xiachufang\\.com/v2/homepage/paged_waterfall_recommendations\\.json$ response-jq del(.multiplex_cells[] | select(.recommendation_cell.impression_sensor_events[]?.properties.target_type? == \"ad\"))"
    - "(?i)^https://api\\.xiachufang\\.com/v2/config/get\\.json$ response-jq delpaths([[\"content\", \"recipe_ad\"],[\"content\", \"splash_ad_req_time\"],[\"content\", \"splash_sdk_ad_req_time\"],[\"content\", \"splash_ad_lifecycle_interval\"],[\"content\", \"waterfall_ad_feedback\"],[\"content\", \"homepage_waterfall_test_ad_pos\"],[\"content\", \"ad_app_look_around\"],[\"content\", \"ad_sdk_text_removal_keywords\"]])"
    - "(?i)^https://api\\.xiachufang\\.com/v2/homepage/ranking_list/paged_homepage_ranking_list_section_v2\\.json$ response-jq .cells |= map(del(.side_slip_activity_cell, .dish_square_cell))"
  mitm:
    - "api.xiachufang.com"
