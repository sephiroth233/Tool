# Generated locally from Loon. Parameters are fixed at build time for Stash.
name: "阅友去广告"
desc: "移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Yueyou.png"
rules:
  - "DOMAIN,ads.reader.yueyouxs.com,REJECT"
http:
  body-rewrite:
    - "(?i)^https://goway\\.reader\\.yueyouxs\\.com/assemble/app/basic/getAppInfo\\? response-jq delpaths([[\"data\", \"isShowDLPopup\"],[\"data\", \"isShowGame\"],[\"data\", \"touTiaoShowDlPopup\"],[\"data\", \"offLineDownload\", \"WatchVideoBtnDesc\"],[\"data\", \"readVipFirstCfg\"],[\"data\", \"readVipNormalCfg\"],[\"data\", \"notifyAd\"],[\"data\", \"hotStartSplashTime\"],[\"data\", \"hotStartReqSwitch\"],[\"data\", \"isShowBFTab\"],[\"data\", \"popReqDelayTime\"],[\"data\", \"benefitCfg\"],[\"data\", \"chestTask\"],[\"data\", \"hotStartAd\"],[\"data\", \"activeTagList\"],[\"data\", \"secondOrderCfg\"],[\"data\", \"secondOrderList\"],[\"data\", \"blockedWordsCfg\"],[\"data\", \"aaReportListCfg\"],[\"data\", \"pddAdSwitch\"],[\"data\", \"isShowShelfAuthPopup\"],[\"data\", \"firstPopUpAmount\"]])"
    - "(?i)^https://goway\\.reader\\.yueyouxs\\.com/assemble/app/basic/getAppInfo\\? response-jq if ((getpath([\"data\"]) // {}) | has(\"isAdClosed\")) then setpath([\"data\", \"isAdClosed\"];true) else . end"
  mitm:
    - "goway.reader.yueyouxs.com"
