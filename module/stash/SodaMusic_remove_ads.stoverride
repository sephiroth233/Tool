http:
  body-rewrite:
    - "(?i)^https://tnc\\d-(bjlgy|ali[a-z]{2})\\d?\\.zijieapi\\.com/get_domains/v\\d/\\? response-jq if ((getpath([\"data\"]) // {}) | has(\"opaque_data_enabled\")) then setpath([\"data\", \"opaque_data_enabled\"];0) else . end | if ((getpath([\"data\"]) // {}) | has(\"ttnet_http_dns_enabled\")) then setpath([\"data\", \"ttnet_http_dns_enabled\"];0) else . end | if ((getpath([\"data\"]) // {}) | has(\"ttnet_quic_enabled\")) then setpath([\"data\", \"ttnet_quic_enabled\"];0) else . end | if ((getpath([\"data\"]) // {}) | has(\"ttnet_tt_http_dns\")) then setpath([\"data\", \"ttnet_tt_http_dns\"];0) else . end"
    - "(?i)^https://tnc\\d-(bjlgy|ali[a-z]{2})\\d?\\.zijieapi\\.com/get_domains/v\\d/\\? response-jq .data.ttnet_dispatch_actions |= map(select(.action != \"dispatch\" and .action != \"tc\"))"
    - "(?i)^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/me\\? response-jq delpaths([[\"reward_ad_banner\"]])"
    - "(?i)^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/feed/song-tab\\? response-jq del(.items[] | select(.type == \"video_track_mix\"))"
    - "(?i)^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/card\\? response-jq delpaths([[\"preview_guide\"]])"
    - "(?i)^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/card\\? response-jq del(.card_items[] | select(has(\"priority_display\")))"
    - "(?i)^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/more-panel\\? response-jq .blocks |= map(select(.type != \"related_video\"))"
